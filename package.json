{
  "name": "meshy-ai-connector",
  "version": "0.1.0",
  "description": "Provider-agnostic MCP server exposing Meshy AI's text-to-3D and image-to-3D generation to Claude Desktop, Claude Code, and Cowork",
  "type": "module",
  "main": "dist/server/mcpServer.js",
  "bin": {
    "meshy-ai-connector": "dist/server/mcpServer.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honeyashu/MeshyAI_MCP_Connector.git"
  },
  "bugs": {
    "url": "https://github.com/honeyashu/MeshyAI_MCP_Connector/issues"
  },
  "homepage": "https://github.com/honeyashu/MeshyAI_MCP_Connector#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "meshy",
    "meshy-ai",
    "3d-generation",
    "text-to-3d",
    "image-to-3d",
    "claude-desktop",
    "claude-code"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/server/mcpServer.js",
    "start": "node dist/server/mcpServer.js",
    "test": "node --test dist",
    "test:watch": "node --test --watch dist",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "archiver": "^7.0.1",
    "zod": "^3.22.4"
  },
  "optionalDependencies": {
    "@gltf-transform/core": "^3.10.1",
    "@gltf-transform/extensions": "^3.10.1",
    "@gltf-transform/functions": "^3.10.1",
    "better-sqlite3": "^9.2.2",
    "draco3d": "^1.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/archiver": "^6.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.18.0"
  }
}
